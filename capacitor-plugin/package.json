{
  "name": "@chromasnap/image-processor",
  "version": "1.0.0",
  "description": "Native Capacitor plugin for ChromaSnap AI image processing",
  "main": "dist/plugin.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/java/com/chromasnap/processor/*.java",
    "ios/Plugin/**/*.swift",
    "dist/",
    "plugin.xml"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rimraf ./dist",
    "lint": "eslint . --ext ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "image-processing",
    "colorization"
  ],
  "author": "ChromaSnap Team",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.8.0",
    "rimraf": "^5.0.0"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.0.0"
  }
}
