# Server runtime settings
PORT=3001

# Comma-separated frontend origins allowed by CORS (required in production)
# Example: CORS_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ORIGINS=http://localhost:5173

# In production keep this false and use authenticated JWT user identity instead.
ALLOW_HEADER_BILLING_ID=false

# Required for API key mode fallback
GEMINI_API_KEY=your_gemini_api_key_here

# Required for Vertex AI mode
GOOGLE_APPLICATION_CREDENTIALS=./config/your-service-account.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Required for secure auth sessions
JWT_SECRET=replace-with-a-long-random-secret

# Optional cookie-session configuration for auth
AUTH_COOKIE_NAME=chromasnap_auth
# Use none for cross-site frontend/backend deployments over HTTPS
AUTH_COOKIE_SAME_SITE=lax

# Optional CAPTCHA verification for repeated failed logins
# If CAPTCHA_SECRET_KEY is empty, non-production mode accepts CAPTCHA_BYPASS_TOKEN.
CAPTCHA_SECRET_KEY=0x4AAAAAACi_ElOnCEOc34KAT1rYVJwkaJM
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_BYPASS_TOKEN=dev-captcha-ok

# Required in production for password reset delivery (webhook endpoint).
# Receives JSON with username, recoveryEmail, resetToken, and expiresAt.
PASSWORD_RESET_WEBHOOK_URL=https://example.com/hooks/password-reset
PASSWORD_RESET_WEBHOOK_TIMEOUT_MS=10000
# Optional shared secret sent as x-reset-webhook-secret header.
PASSWORD_RESET_WEBHOOK_SHARED_SECRET=replace-with-a-long-random-secret
# Optional: when true, receiver returns success without sending provider email.
PASSWORD_RESET_WEBHOOK_DRY_RUN=false

# Password reset webhook receiver email-delivery configuration (SendGrid example).
PASSWORD_RESET_EMAIL_PROVIDER=auto
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
MAILGUN_API_KEY=key-xxxxx
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=no-reply@yourdomain.com
PASSWORD_RESET_LINK_TEMPLATE=https://chromasnap.app/reset-password?token={{token}}
# Optional fallback if no template is set.
PASSWORD_RESET_LINK_BASE_URL=https://chromasnap.app/reset-password

# Required for admin username endpoints
ADMIN_API_KEY=replace-with-a-long-random-secret

# Firebase Auth (required for Google/Phone social login verification)
FIREBASE_PROJECT_ID=chrommasnap-vertex-ai-use
# Optional for local/dev if ADC is unavailable. Put full one-line JSON service account payload.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
