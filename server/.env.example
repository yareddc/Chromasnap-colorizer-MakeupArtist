# Server runtime settings
PORT=3001

# Required for PostgreSQL username/auth storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chromasnap
# Optional: set to require when your PostgreSQL provider enforces TLS
PGSSLMODE=disable
# Optional when PGSSLMODE=require (set false for providers with self-signed certs)
PGSSL_REJECT_UNAUTHORIZED=true

# Required for API key mode fallback
GEMINI_API_KEY=your_gemini_api_key_here

# Required for Vertex AI mode
GOOGLE_APPLICATION_CREDENTIALS=./config/your-service-account.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Required for secure auth sessions
JWT_SECRET=replace-with-a-long-random-secret

# Optional CAPTCHA verification for repeated failed logins
# If CAPTCHA_SECRET_KEY is empty, non-production mode accepts CAPTCHA_BYPASS_TOKEN.
CAPTCHA_SECRET_KEY=0x4AAAAAACi_ElOnCEOc34KAT1rYVJwkaJM
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_BYPASS_TOKEN=dev-captcha-ok

# Required for admin username endpoints
ADMIN_API_KEY=replace-with-a-long-random-secret

# Optional Stripe checkout integration for token purchases
STRIPE_SECRET_KEY=sk_test_your_secret_key
PUBLIC_APP_URL=http://localhost:3000
